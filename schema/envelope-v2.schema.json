{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://averox.com/schemas/envelope-v2.json",
  "title": "Averox Canonical v2 Envelope",
  "description": "Enterprise cryptographic envelope format v2 for cross-language interoperability",
  "type": "object",
  "required": ["v", "alg", "iv", "tag", "ct"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "string",
      "const": "2",
      "description": "Envelope format version (mandatory string)"
    },
    "alg": {
      "type": "string",
      "enum": ["AES-256-GCM"],
      "description": "Algorithm identifier from supported registry"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Optional key identifier for key rotation"
    },
    "iv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$",
      "description": "12-byte initialization vector as base64url (no padding)"
    },
    "tag": {
      "type": "string", 
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "16-byte authentication tag as base64url (no padding)"
    },
    "ct": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Encrypted ciphertext as base64url (no padding)"
    }
  },
  "examples": [
    {
      "v": "2",
      "alg": "AES-256-GCM",
      "iv": "AAECAwQFBgcICQoL",
      "tag": "dGFnMTIzNDU2Nzg5MDEyMzQ1Ng",
      "ct": "SGVsbG8sIFdvcmxkIQ"
    },
    {
      "v": "2", 
      "alg": "AES-256-GCM",
      "kid": "primary-key-2024-01",
      "iv": "AAECAwQFBgcICQoL",
      "tag": "dGFnMTIzNDU2Nzg5MDEyMzQ1Ng",
      "ct": "U2VjcmV0IGRhdGE"
    }
  ]
}